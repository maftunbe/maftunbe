# --- Hard risk limits enforced in code, never by the LLM ---
MAX_OPEN_POSITIONS=1
MAX_LOSS_PCT_OF_BALANCE=0.25
MIN_REWARD_TO_RISK=2.0
MAX_TRADES_PER_DAY=3

# --- Symbols the desk scans each cycle ---
WATCHED_SYMBOLS=BTC/USDT,ETH/USDT

# --- Cycle interval in minutes ---
CYCLE_INTERVAL_MINUTES=60
